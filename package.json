{
  "name": "convertzz",
  "version": "2.0.0-beta7",
  "private": true,
  "packageManager": "pnpm@11.21.0",
  "description": "ConvertZZ cross-platform Chinese text conversion desktop application",
  "license": "GPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:e2e": "node scripts/dev-web-e2e.mjs",
    "build": "pnpm run typecheck && vite build",
    "build:web": "vite build",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:qemu": "node scripts/verify-linux-qemu.mjs",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "fmt": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "prepare": "node scripts/setup-git-hooks.mjs",
    "check": "prettier --check . && pnpm run typecheck && pnpm test && pnpm run build:web"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "2.3.2",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-global-shortcut": "2.3.2",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-store": "2.4.4",
    "@tauri-apps/plugin-updater": "2.10.1",
    "element-plus": "2.14.4",
    "vue": "3.5.41",
    "vue-router": "5.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "24.13.3",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.9"
  }
}
